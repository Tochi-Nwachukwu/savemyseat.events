{
  "name": "savemyseat",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @savemyseat/db generate",
    "db:migrate": "pnpm --filter @savemyseat/db migrate",
    "db:deploy": "pnpm --filter @savemyseat/db migrate:deploy",
    "db:push": "pnpm --filter @savemyseat/db push",
    "db:seed": "pnpm --filter @savemyseat/db seed",
    "db:studio": "pnpm --filter @savemyseat/db studio",
    "admin:create": "pnpm --filter @savemyseat/web admin:create"
  },
  "devDependencies": {
    "@neon/config": "^1.9.4",
    "@neon/env": "^1.6.5",
    "turbo": "^2.11.10",
    "typescript": "5.9.3"
  }
}
