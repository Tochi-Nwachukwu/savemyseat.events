# ─── Neon (written by `neon deploy` / `neon env pull`; don't edit by hand) ───
# Pooled connection for the app; unpooled for Prisma migrations
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""
NEON_BRANCH=""
# Object Storage ("invitations" bucket, public_read)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_ENDPOINT_URL_S3=""
AWS_REGION=""

# ─── App ─────────────────────────────────────────────────────────────────────
# Public base URL, no trailing slash
APP_URL="http://localhost:3000"

# Auth (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=""

# Resend
RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET=""
EMAIL_FROM="SaveMySeat <invites@savemyseat.events>"
